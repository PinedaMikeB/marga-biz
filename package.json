{
  "name": "marga-biz",
  "version": "2.0.0",
  "description": "Marga Enterprises official website - Static Site Generator",
  "scripts": {
    "generate": "node scripts/generate-site.js",
    "generate:old": "node scripts/generate-pages.js",
    "serp:monitor": "node scripts/serp-monitor.js",
    "serp:monitor:all": "node scripts/serp-monitor.js --set=all",
    "seo:morning-review": "node scripts/morning-seo-review.js",
    "seo:approval-status": "node scripts/process-telegram-approval.js status",
    "seo:approval-processed": "node scripts/process-telegram-approval.js mark-processed",
    "telegram:bot": "node scripts/telegram-approval.js bot-info",
    "telegram:discover": "node scripts/telegram-approval.js discover-chat",
    "telegram:send": "node scripts/telegram-approval.js send-message",
    "telegram:check": "node scripts/telegram-approval.js check-approvals",
    "telegram:daemon": "node scripts/telegram-chat-daemon.js",
    "sync-images": "node scripts/sync-images.js",
    "serve": "cd dist && npx http-server . -p 8080 -o",
    "serve:root": "npx http-server . -p 8080 -o",
    "build": "npm run generate",
    "deploy": "netlify deploy --prod --dir=dist",
    "clean": "rm -rf dist/*"
  },
  "author": "Marga Enterprises",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "@google-analytics/data": "^4.0.0",
    "googleapis": "^128.0.0"
  }
}
